---
// Favicon tags shared by every page (Starlight's Head.astro and the custom
// index / join / 404 pages), so they can't drift apart again.
//
// Search engines render ONE static icon on both light and dark result pages, so
// the raster icons are the white rings on a solid black square (readable on
// either). Browser tabs get the theme-aware SVG on top: black rings in light
// mode, silver rings in dark mode.
---

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" id="os-favicon" />

<script is:inline>
  (() => {
    const link = document.querySelector('link#os-favicon');
    if (!link) return;
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const apply = (isDark) => link.setAttribute('href', isDark ? '/favicon.svg' : '/favicon-dark.svg');
    apply(mq.matches);
    mq.addEventListener('change', (e) => apply(e.matches));
  })();
</script>
