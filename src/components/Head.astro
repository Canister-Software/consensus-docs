---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { ogImagePath } from '../og';
import Favicons from './Favicons.astro';

const { head, id } = Astro.locals.starlightRoute;
type HeadEntry = StarlightRouteData['head'][number];

// Hand-made card, else the build-time generated one (see src/og.ts)
const ogPath = ogImagePath(id);
const ogImage = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;

const hasMeta = (key: 'name' | 'property' | 'http-equiv', value: string) =>
  head.some((entry: HeadEntry) => entry.tag === 'meta' && entry.attrs?.[key] === value);

const hasOgImage = hasMeta('property', 'og:image');
const hasOgImageWidth = hasMeta('property', 'og:image:width');
const hasOgImageHeight = hasMeta('property', 'og:image:height');
const hasTwitterImage = hasMeta('name', 'twitter:image');
const hasTwitterCard = hasMeta('name', 'twitter:card');
---

{
  head.map((entry: HeadEntry) => {
    const { tag: Tag, attrs, content } = entry;
    return <Tag {...attrs} set:html={content} />;
  })
}

{!hasOgImage && <meta property="og:image" content={ogImage} />}
{!hasOgImageWidth && <meta property="og:image:width" content="2400" />}
{!hasOgImageHeight && <meta property="og:image:height" content="1260" />}
{!hasTwitterImage && <meta name="twitter:image" content={ogImage} />}
{!hasTwitterCard && <meta name="twitter:card" content="summary_large_image" />}

<!-- Fonts: self-hosted variable woff2 (@font-face lives in src/styles/custom.css) -->
<link rel="preload" href="/fonts/space-grotesk-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/jetbrains-mono-variable.woff2" as="font" type="font/woff2" crossorigin />

<Favicons />

<script is:inline>
  (() => {
    const selector = '.consensus-diagram';

    const init = () => {
      const existing = document.getElementById('diagram-lightbox');
      const dialog =
        existing ||
        (() => {
          const el = document.createElement('dialog');
          el.id = 'diagram-lightbox';
          el.innerHTML = `
            <div class="diagram-lightbox__frame">
              <img class="diagram-lightbox__img" alt="" />
            </div>
          `;
          (document.body || document.documentElement).appendChild(el);
          return el;
        })();

      const img = dialog.querySelector('.diagram-lightbox__img');
      if (!img) return;

      const close = () => {
        dialog.removeAttribute('data-zoom');
        dialog.removeAttribute('data-zoom-origin');
        img.removeAttribute('src');
        dialog.close();
      };

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) close();
      });

      dialog.addEventListener('close', () => {
        dialog.removeAttribute('data-zoom');
        dialog.removeAttribute('data-zoom-origin');
        img.removeAttribute('src');
      });

      img.addEventListener('click', (e) => {
        e.stopPropagation();
        dialog.dataset.zoom = dialog.dataset.zoom === 'in' ? '' : 'in';
      });

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLImageElement)) return;
        if (!target.matches(selector)) return;
        e.preventDefault();
        img.src = target.currentSrc || target.src;
        img.alt = target.alt || '';
        dialog.showModal();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
