<script is:inline>
  // ── Mobile menu toggle ─────────────────────────────────────
  (function () {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    const bars = btn.querySelectorAll('span');
    let open = false;
    const setMenu = (v) => {
      open = v;
      menu.style.display = v ? 'flex' : 'none';
      btn.setAttribute('aria-expanded', v ? 'true' : 'false');
      btn.setAttribute('aria-label', v ? 'Close menu' : 'Open menu');
      if (bars.length === 3) {
        bars[0].style.transform = v ? 'translateY(7px) rotate(45deg)' : 'none';
        bars[1].style.opacity = v ? '0' : '1';
        bars[2].style.transform = v ? 'translateY(-7px) rotate(-45deg)' : 'none';
      }
    };
    btn.addEventListener('click', () => setMenu(!open));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    window.addEventListener('resize', () => { if (window.innerWidth > 820 && open) setMenu(false); });
  })();

  // ── Copy-to-clipboard for [data-copy] buttons ──────────────
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-copy') || '';
      try { navigator.clipboard && navigator.clipboard.writeText(cmd); } catch (_) {}
      const lbl = btn.querySelector('[data-copy-label]');
      if (lbl) { const prev = lbl.textContent; lbl.textContent = 'Copied'; setTimeout(() => { lbl.textContent = prev; }, 1400); }
    });
  });

  // ── Scroll reveal ──────────────────────────────────────────
  (function () {
    const reveal = (el) => {
      if (el.dataset.revealed) return;
      el.dataset.revealed = '1';
      el.style.transitionDelay = (el.getAttribute('data-reveal-delay') || 0) + 'ms';
      el.style.opacity = '1';
      el.style.transform = 'none';
    };
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(18px)';
      el.style.transition = 'opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)';
      el.style.willChange = 'opacity, transform';
    });
    const check = () => {
      const vh = window.innerHeight || document.documentElement.clientHeight;
      document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < vh * 0.9 && r.bottom > 0) reveal(el);
      });
    };
    // nav links appear only after their section scrolls under the header
    const navCheck = () => {
      document.querySelectorAll('[data-navlink]').forEach((a) => {
        const sec = document.getElementById(a.getAttribute('data-navlink'));
        if (!sec) return;
        const passed = sec.getBoundingClientRect().top <= 72;
        a.style.opacity = passed ? '1' : '0';
        a.style.pointerEvents = passed ? 'auto' : 'none';
      });
    };
    check(); navCheck();
    window.addEventListener('scroll', () => { check(); navCheck(); }, { passive: true });
    window.addEventListener('resize', () => { check(); navCheck(); });
    setTimeout(() => document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(reveal), 3000);
  })();

  // ── Auto-size the live terminal iframes to their content ────
  (function () {
    // Fit each terminal to its OWN content (no forced uniform height), so there is
    // no leftover black padding and the gap down to the snippet/title is identical
    // for every act. None of them scroll.
    const sizeOne = (f) => {
      try {
        const win = f.contentDocument && f.contentDocument.querySelector('.term-window');
        if (win) {
          const h = Math.ceil(win.getBoundingClientRect().height);
          if (h > 120 && h < 2000) f.style.height = (h + 8) + 'px';
        }
      } catch (_) {}
    };
    const sizeIframes = () => document.querySelectorAll('#build iframe').forEach(sizeOne);
    document.querySelectorAll('#build iframe').forEach((f) => {
      f.addEventListener('load', () => {
        const refit = () => sizeOne(f);
        let pending = false;
        const schedule = () => { if (pending) return; pending = true; setTimeout(() => { pending = false; refit(); }, 60); };
        refit(); setTimeout(refit, 300); setTimeout(refit, 900); setTimeout(refit, 1800);
        // Some screens (e.g. WebSockets) build their terminal and keep appending rows
        // AFTER load. The screens use zoom:0.6, which suppresses ResizeObserver, so
        // watch the DOM directly: any node change re-fits the frame to its content,
        // so it grows to show everything instead of clipping into a scrollbar.
        try {
          const MO = f.contentWindow && f.contentWindow.MutationObserver;
          const body = f.contentDocument && f.contentDocument.body;
          if (MO && body) new MO(schedule).observe(body, { childList: true, subtree: true, characterData: true });
        } catch (_) {}
      });
    });
    setTimeout(sizeIframes, 1200);
    window.addEventListener('resize', sizeIframes);
  })();
</script>

