&#125;)

<span style="color:rgba(255,255,255,0.45)">const</span> session = <span style="color:rgba(255,255,255,0.45)">await</span> client.connect(auth)
session.on(<span style="color:rgba(255,255,255,0.62)">'message'</span>, (m) => console.log(<span style="color:rgba(255,255,255,0.62)">'recv'</span>, m))</code></pre>
