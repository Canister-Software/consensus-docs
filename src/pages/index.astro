<span style="color:rgba(255,255,255,0.38);font-style:italic">// intercepts outbound HTTP transparently</span>
<span style="color:rgba(255,255,255,0.45)">const</span> fetch = ProxyClient.wrap(globalThis.fetch)

<span style="color:rgba(255,255,255,0.45)">const</span> res = <span style="color:rgba(255,255,255,0.45)">await</span> fetch(<span style="color:rgba(255,255,255,0.62)">'https://external.com'</span>, &#123;
  region:   <span style="color:rgba(255,255,255,0.62)">'us-east'</span>,
  caching:  <span style="color:rgba(255,255,255,0.45)">true</span>,
  spendCap: <span style="color:rgba(255,255,255,0.62)">'0.05'</span>,   <span style="color:rgba(255,255,255,0.38);font-style:italic">// stands down to direct fetch when hit</span>
&#125;)</code></pre>
