<script is:inline>
  // ── Copy-to-clipboard for [data-copy] buttons ──────────────
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-copy') || '';
      try { navigator.clipboard && navigator.clipboard.writeText(cmd); } catch (_) {}
      const lbl = btn.querySelector('[data-copy-label]');
      if (lbl) { const prev = lbl.textContent; lbl.textContent = 'Copied'; setTimeout(() => { lbl.textContent = prev; }, 1400); }
    });
  });

  // ── Scroll reveal ──────────────────────────────────────────
  (function () {
    const reveal = (el) => {
      if (el.dataset.revealed) return;
      el.dataset.revealed = '1';
      el.style.transitionDelay = (el.getAttribute('data-reveal-delay') || 0) + 'ms';
      el.style.opacity = '1';
      el.style.transform = 'none';
    };
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(18px)';
      el.style.transition = 'opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)';
      el.style.willChange = 'opacity, transform';
    });
    const check = () => {
      const vh = window.innerHeight || document.documentElement.clientHeight;
      document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < vh * 0.9 && r.bottom > 0) reveal(el);
      });
    };
    // nav links appear only after their section scrolls under the header
    const navCheck = () => {
      document.querySelectorAll('[data-navlink]').forEach((a) => {
        const sec = document.getElementById(a.getAttribute('data-navlink'));
        if (!sec) return;
        const passed = sec.getBoundingClientRect().top <= 72;
        a.style.opacity = passed ? '1' : '0';
        a.style.pointerEvents = passed ? 'auto' : 'none';
      });
    };
    check(); navCheck();
    window.addEventListener('scroll', () => { check(); navCheck(); }, { passive: true });
    window.addEventListener('resize', () => { check(); navCheck(); });
    setTimeout(() => document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(reveal), 3000);
  })();

  // ── Auto-size the live terminal iframes to their content ────
  (function () {
    // Give every terminal ONE uniform height: the tallest terminal's content,
    // so they line up in a grid and none of them scroll.
    const sizeIframes = () => {
      const frames = [...document.querySelectorAll('#build iframe')];
      let max = 0;
      for (const f of frames) {
        try {
          const win = f.contentDocument && f.contentDocument.querySelector('.term-window');
          if (win) max = Math.max(max, Math.ceil(win.getBoundingClientRect().height));
        } catch (_) {}
      }
      if (max > 120 && max < 1600) {
        const h = (max + 26) + 'px';
        for (const f of frames) f.style.height = h;
      }
    };
    document.querySelectorAll('#build iframe').forEach((f) => {
      f.addEventListener('load', () => { sizeIframes(); setTimeout(sizeIframes, 600); setTimeout(sizeIframes, 1600); });
    });
    setTimeout(sizeIframes, 1200);
    window.addEventListener('resize', sizeIframes);
  })();
</script>

