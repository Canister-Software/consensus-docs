<span style="color:rgba(255,255,255,0.45)">const</span> client = SocketClient(fetchWithPayment)

<span style="color:rgba(255,255,255,0.38);font-style:italic">// prepay a bounded, metered session</span>
<span style="color:rgba(255,255,255,0.45)">const</span> auth = <span style="color:rgba(255,255,255,0.45)">await</span> client.requestToken(&#123;
