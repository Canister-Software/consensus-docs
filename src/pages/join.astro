        {
          "@type": "HowTo",
          "name": "Three steps to a live Consensus node",
          "description": "Install the Consensus node runtime, pass the guided setup and admission benchmark, then keep the node running under pm2.",
          "totalTime": "PT30M",
          "supply": [
            { "@type": "HowToSupply", "name": "A machine with 8 GB memory, 4 cores, 50 GB SSD and 100 Mbps bandwidth" },
            { "@type": "HowToSupply", "name": "One static public IPv4 address with one open inbound port" }
          ],
