---
import Favicons from '../components/Favicons.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found | Consensus</title>
  <meta name="description" content="This page doesn't exist, or the link is broken." />
  <meta name="robots" content="noindex" />
  <Favicons />
  <!-- Served by GitHub Pages at whatever path was requested, so every URL here is absolute -->
  <link rel="preload" href="/fonts/space-grotesk-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-variable.woff2" as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:300 700;font-display:swap;src:url('/fonts/space-grotesk-variable.woff2') format('woff2')}
    @font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:100 800;font-display:swap;src:url('/fonts/jetbrains-mono-variable.woff2') format('woff2')}
    *{box-sizing:border-box}
    body{margin:0;background:#000;color:#fff;font-family:'Space Grotesk',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    a:hover{color:#fff}
    .btn-secondary{transition:border-color .2s ease}
    .btn-secondary:hover{border-color:rgba(255,255,255,0.4) !important}
  </style>
</head>
<body>

<main style="width:100%;min-height:100vh;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;padding:40px 28px;text-align:center">
  <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:#fff">
    <img src="/logo-light.svg" alt="" width="28" height="28" style="display:block" />
    <span style="font-weight:600;font-size:18px;letter-spacing:-0.01em">Consensus</span>
  </a>
  <div style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.45)">404</div>
  <h1 style="margin:0;font-size:clamp(34px,5vw,56px);line-height:1;letter-spacing:-0.03em;font-weight:600">Page not found.</h1>
  <p style="margin:0;font-size:17px;line-height:1.55;color:rgba(255,255,255,0.6);max-width:42ch">This page doesn't exist, or the link is broken.</p>
  <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
    <a href="/" style="text-decoration:none;font-size:15px;font-weight:500;color:#000;background:#fff;padding:12px 20px;border-radius:10px">Back to home</a>
    <a href="/quickstart/request/" class="btn-secondary" style="text-decoration:none;font-size:15px;font-weight:500;color:#fff;border:1px solid rgba(255,255,255,0.16);padding:12px 20px;border-radius:10px">Read the docs</a>
  </div>
</main>

</body>
</html>
